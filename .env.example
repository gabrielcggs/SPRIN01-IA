# Escolha o provedor: gemini (gratuito) ou openai
LLM_PROVIDER=gemini

# Gemini — obtenha em https://aistudio.google.com/apikey
GOOGLE_API_KEY=sua_chave_gemini_aqui

# OpenAI — obtenha em https://platform.openai.com/api-keys
OPENAI_API_KEY=sua_chave_openai

# Modelo (opcional)
# Modelo mais leve para reduzir risco de alta demanda/cota
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_MODEL=gpt-4o-mini
